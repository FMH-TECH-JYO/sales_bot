{
  "name": "forbes-marshall-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "server",
    "db",
    "web"
  ],
  "scripts": {
    "setup": "node db/setup.js",
    "db:migrate": "node db/migrate.js",
    "db:migrate-file": "node db/runSql.js",
    "db:seed": "node db/seed.js",
    "db:export-catalogue": "node db/exportCatalogue.js",
    "db:import-catalogue": "node db/importCatalogue.js",
    "db:backfill-chunks": "node db/backfillDatasheetChunks.js",
    "catalogue:sync": "node db/syncCatalogueToGit.js",
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "db:import-uploads": "node db/importUploadsToDb.js",
    "user:create": "node db/createUser.js",
    "test": "node --test --test-concurrency=1",
    "test:coverage": "node --test --experimental-test-coverage --test-concurrency=1",
    "lint": "eslint .",
    "build": "npm run build --workspace=web",
    "start": "node server/src/index.js"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "jspdf": "^4.2.1",
    "pg": "^8.23.0",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0"
  },
  "overrides": {
    "qs@<6.16.0": "^6.16.0"
  }
}
