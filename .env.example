# Copy this file to .env in the repo root.
#
# You normally don't have to: config/env.js creates .env from this file
# automatically the first time anything runs without one, so a fresh
# `git clone` works out of the box. Edit .env if your setup differs.
#
# .env is gitignored on purpose — it can hold real credentials, so it never
# travels with the repo. That is why every value here must have a working
# local default.

# --- Database ---
# Matches docker-compose.yml, so `docker compose up -d` + `npm run setup` works
# with no edits. Point this at a shared Postgres instead when you want both
# machines to see the same catalogue with no export/import step at all.
DATABASE_URL=postgresql://fm:fm_dev_password@localhost:5432/fm_platform

# --- File storage (Phase 1: local disk) ---
# LOCAL_UPLOAD_DIR is resolved against the REPO ROOT (see config/env.js
# uploadDir()). './server/uploads' therefore means <repo>/server/uploads —
# the same folder whose PDFs are committed to git. Do not change this to
# 'uploads' or './uploads'; those point somewhere the app doesn't read.
# "local" keeps datasheet PDFs on this machine's disk under LOCAL_UPLOAD_DIR.
# "db"    keeps them in Postgres (catalogue_blobs), so every machine pointed at
#         the same database sees the same catalogue with no git commit of
#         binaries, no export/import step, and no per-machine drift.
# Moving from local to db: run `npm run db:import-uploads` ONCE on the machine
# that has the files, then set STORAGE_DRIVER=db everywhere.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./server/uploads

# How much datasheet text is sent to the extraction model. The full
# specification table (~28 rows for a pressure gauge) is often on page 2-3, so
# truncating too early silently drops rows from the customer's offer. Lower it
# only if you are running a small local model that degrades on long prompts.
EXTRACTION_MAX_CHARS=24000

# --- LLM (Phase 3 wires this up; leave as-is for now) ---
LLM_PROVIDER=local-ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# --- Web search fallback for enquiry matching (optional) ---
# Internal catalogues are ALWAYS checked first. This is only used when a
# candidate's published datasheet doesn't confirm a spec the customer asked
# about. Leave WEB_SEARCH_PROVIDER=none (or unset) to disable it entirely —
# unconfirmed specs are then reported as "missing", never guessed.
# Set to "tavily" or "serper" and provide the matching key below to enable.
WEB_SEARCH_PROVIDER=none
TAVILY_API_KEY=
SERPER_API_KEY=

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Security ---
# Origins allowed to call this API from a browser, comma-separated. In
# development http://localhost:5173 (Vite) is always allowed in addition to
# whatever is listed here. In PRODUCTION only this list is allowed, and an
# empty list means "same origin only" — which is the right answer when Express
# is also serving web/dist, because there is then no cross-origin call to make.
# The old behaviour (cors() with no arguments, i.e. Access-Control-Allow-Origin: *)
# is not merely unsafe now that sessions exist, it is impossible: the spec
# forbids combining a wildcard origin with credentials.
CORS_ORIGINS=

# Session cookie flags. Secure is forced on automatically when
# NODE_ENV=production; set COOKIE_SECURE=true to test HTTPS behaviour locally.
# COOKIE_SAMESITE=none is needed ONLY if the browser app is served from a
# different site than the API in production — and 'none' requires Secure.
COOKIE_SECURE=
COOKIE_SAMESITE=

# Set when running behind a reverse proxy so req.ip is the real client rather
# than the proxy — otherwise the rate limiter sees every user as one client.
# Value is passed to Express's `trust proxy` setting: a hop count (1) or a
# subnet. Leave EMPTY when nothing is in front, or a client can spoof
# X-Forwarded-For and escape rate limiting entirely.
TRUST_PROXY=

# Largest accepted JSON request body. Uploads are limited separately by multer.
JSON_BODY_LIMIT=256kb

# Development escape hatch for the rate limiters, honoured ONLY when
# NODE_ENV is not production. The test suite sets it.
DISABLE_RATE_LIMIT=
